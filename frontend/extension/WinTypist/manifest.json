{
  "manifest_version": 3,
  "name": "WinTypist",
  "version": "1.0.0",
  "description": "Autocomplete suggestions for your browser",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/logo.png",
      "48": "public/logo.png",
      "128": "public/logo.png"
    }
  },
  "icons": {
    "16": "public/logo.png",
    "48": "public/logo.png",
    "128": "public/logo.png"
  }
}
